{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker service name in the Cloudflare dashboard.
  // Workers Builds deploys to this script, and WORKER_SELF_REFERENCE below
  // must point at the SAME name or the deploy fails with error 10143.
  "name": "home-design",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "home-design"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
