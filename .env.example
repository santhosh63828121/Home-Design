# ──────────────────────────────────────────────────────────────────────────
# RGL Decors — environment variables (copy to .env / .env.local and fill in)
# ──────────────────────────────────────────────────────────────────────────

# Public site URL — canonical URLs, sitemap, robots, OG tags.
NEXT_PUBLIC_SITE_URL=https://www.rgldecors.com

# ── Database (Prisma) ──
# Dev (zero-setup): SQLite file. Prod: switch schema.prisma provider to
# "postgresql" and use a Postgres connection string.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rgldecors?schema=public"

# ── Lead notification email (pick ONE provider; both optional) ──
# Where new-lead notifications are sent:
LEAD_NOTIFY_EMAIL=rgldecors@gmail.com

# Option A — Resend (recommended; uses the REST API, no SDK):
RESEND_API_KEY=
LEAD_FROM_EMAIL="RGL Decors <leads@rgldecors.com>"   # must be a verified sender

# Option B — SMTP via Nodemailer (e.g. Hostinger / Gmail SMTP):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RGL Decors <leads@rgldecors.com>"

# ── Analytics (optional, env-gated) ──
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Auto-reply confirmation to enquirers (default on; set to "off" to disable).
# Delivery to arbitrary addresses needs a verified sender domain (see LEAD_FROM_EMAIL).
LEAD_AUTOREPLY=on
